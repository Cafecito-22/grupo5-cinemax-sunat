{
  "info": {
    "name": "SUNAT Grupo 5 · Flujo completo y seguridad",
    "_postman_id": "9dc2d297-96d7-42a1-a0b9-c2aac6fad06f",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección de pruebas sobre una base QA. Crea datos de prueba; no usar sobre producción sin revisar las solicitudes. Completa las credenciales en un entorno local, nunca en GitHub."
