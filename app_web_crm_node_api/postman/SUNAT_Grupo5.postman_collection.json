  "item": [
    {
      "name": "01 · Salud de API y base de datos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/salud",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('run_id',String(Date.now()));pm.environment.set('qa_correo','qa.'+pm.environment.get('run_id')+'@sunat.test');pm.environment.set('qa_password','SUNAT-'+pm.variables.replaceIn('{{$randomUUID}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Base conectada',()=>pm.expect(pm.response.json().base_datos).eq('conectada'));"
            ]
          }
        }
      ]
    },
    {
