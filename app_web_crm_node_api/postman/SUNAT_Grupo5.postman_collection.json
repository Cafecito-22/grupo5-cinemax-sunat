        "url": "{{base_url}}/auth/registro",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"Cliente QA\", \"correo\": \"{{qa_correo}}\", \"password\": \"{{qa_password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "const d=pm.response.json();pm.environment.set('cliente_token',d.token);pm.environment.set('cliente_id',d.user.id);pm.test('Rol de contribuyente',()=>pm.expect(d.user.roles).to.deep.include({modulo:'sunat',rol:'cliente'}));"
            ]
